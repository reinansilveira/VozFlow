# Copie para .env e preencha antes de `npm run build`.
# URL das Edge Functions do Supabase (local: http://127.0.0.1:54321/functions/v1).
VITE_LICENSE_API_URL=https://SEU-PROJETO.supabase.co/functions/v1
# Chave pública do passe, gerada por `node scripts/gerar-chaves-passe.mjs`.
VITE_LICENSE_PUBLIC_KEY=
# Checkout da Cakto e contato do suporte (opcionais; mostram os botões "Assinar" e "Suporte").
VITE_CHECKOUT_URL=
VITE_SUPPORT_URL=
# Domínio do site, para os links de Termos de Uso e Política de Privacidade no cartão de teste.
VITE_SITE_URL=
